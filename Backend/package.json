{
  "name": "gotham-restaurant-backend",
  "version": "1.0.0",
  "description": "Gotham Restaurant API - Node.js Express TypeScript MongoDB",
  "main": "dist/server.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "seed": "ts-node-dev src/seed/seed.ts",
    "build": "tsc",
    "start": "node dist/server.js"
  },
  "keywords": [
    "gotham",
    "restaurant",
    "express",
    "typescript",
    "mongodb",
    "mern"
  ],
  "author": "Gotham Team",
  "license": "ISC",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.5.1",
    "morgan": "^1.10.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/morgan": "^1.9.9",
    "@types/node": "^20.14.10",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.5.3"
  }
}
